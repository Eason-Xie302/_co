// File name: projects/05/Computer.hdl

/**
 * The HACK computer, including CPU, ROM and RAM.
 * When reset is 0, the program stored in the computer's ROM executes.
 * When reset is 1, the execution of the program restarts. 
 * Thus, to start a program's execution, reset must be pushed "up" (1)
 * and "down" (0). From this point onward the user is at the mercy of 
 * the software. In particular, depending on the program's code, the 
 * screen may show some output and the user may be able to interact 
 * with the computer via the keyboard.
 */

CHIP Computer {

    IN reset;

    PARTS:
    // Put your code here:
    PARTS:
    // ROM (讀取指令)：位址來自 CPU 的 pc，輸出 instruction 給 CPU
    ROM32K(address=pc, out=instruction);
    
    // CPU：接收指令和記憶體資料，輸出運算結果和下一個 pc
    CPU(inM=memOut, instruction=instruction, reset=reset, 
        outM=outM, writeM=writeM, addressM=addressM, pc=pc);
        
    // Memory (存取資料)：接收 CPU 的位址和寫入資料，輸出 memOut 回傳給 CPU
    Memory(in=outM, load=writeM, address=addressM, out=memOut);
}
